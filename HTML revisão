<!DOCTYPE html> <!-- Documento HTML5 -->
<html lang="pt-br"> <!-- Página em português do Brasil -->
    <head> <!-- Cabeçalho da página -->
        <meta name="viewport" content="width=device-width, initial-scale=1.0"> <!-- Ajusta a página para telas menores -->
        <meta charset="UTF-8"> <!-- Define a codificação da página -->
        <title>MotoMais - Loja de Motos</title> <!-- Título da aba do navegador -->
    </head> <!-- Fecha o cabeçalho -->
    <body> <!-- Corpo da página -->
        <h1>MotoMais - Loja de Motos</h1> <!-- Título principal -->
        <h2>Encontre a moto ideal para você!</h2> <!-- Subtítulo -->

        <!-- Formulário principal -->
        <form>
            <label for="nome">Nome: </label>
            <input type="text" name="nome" id="nome" required placeholder="Preencha seu nome completo">
            <br>

            <label for="cpf">CPF: </label>
            <input type="text" name="cpf" id="cpf" required placeholder="Digite somente os números. Ex: 0009990099">
            <br>

            <label for="endereco">Endereço: </label><br>
            <input type="text" name="rua" id="rua" placeholder="Digite a rua, avenida, beco"><br>
            <input type="text" name="numero" id="numero" placeholder="Digite o número da casa"><br>
            <input type="text" name="bairro" id="bairro" placeholder="Qual seu bairro?"><br>
            <input type="text" name="complemento" id="complemento" placeholder="Ex.: Apto"><br>
            <input type="text" name="referencia" id="referencia" placeholder="Informe um ponto de referência para facilitar a entrega">
            <br>

            <label for="telefone">Telefone: </label>
            <input type="tel" name="telefone" id="telefone" placeholder="(xx)xxxx-xxxx">

            <label for="nascimento">Data de Nascimento: </label>
            <input type="date" name="nascimento" id="nascimento">
            <br>

            <button type="submit">Confirmar</button>
        </form>
    </body>
</html>


        <hr>
        <!-- Formulário de cadastro de promoção -->
        <h3>Cadastro de Promoção</h3>
        <form>
            <label for="nomePromocao">Nome da promoção:</label><br>
            <input type="text" id="nomePromocao" name="nomePromocao" placeholder="Ex.: Moto X 150" required>
            <br><br>

            <label for="tituloPromocao">Título da promoção:</label><br>
            <input type="text" id="tituloPromocao" name="tituloPromocao" placeholder="Ex.: Oferta imperdível de verão" required>
            <br><br>

            <label for="precoPromocao">Preço:</label><br>
            <input type="number" id="precoPromocao" name="precoPromocao" min="0" step="0.01" placeholder="Ex.: 17999.90" required>
            <br><br>

            <label for="descricaoPromocao">Descrição da promoção:</label><br>
            <textarea id="descricaoPromocao" name="descricaoPromocao" rows="5" cols="40" placeholder="Descreva os detalhes da promoção" required></textarea>
            <br><br>

            <button type="submit">Salvar promoção</button>
        </form>
    </body>
</html>
